# Copy this file to backend/.env and fill in what you need.
# Nothing below is required to run the platform locally in demo mode -
# every integration degrades gracefully when its credentials are absent.

# --- Database (defaults to local SQLite if unset) ---
DATABASE_URL=postgresql+psycopg2://certadmin:certpass@localhost:5432/certplatform

# --- Auth ---
SECRET_KEY=change_me_to_a_random_secret

# --- AI Agent (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=gpt-4o-mini

# --- AWS ACM ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Azure Key Vault ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=

# --- GCP Certificate Manager ---
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Kubernetes ---
KUBE_CONFIG_PATH=

# --- Auto-renewal ---
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=true
VAULT_ADDR=
VAULT_TOKEN=

# --- Notifications ---
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#cert-alerts
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CERT
