# Copy to .env (repo root) and edit. `.env` is gitignored; never commit real secrets.
# Everything below is optional unless marked REQUIRED.

# --- Runtime ---
ENV=development                  # development | production (production refuses placeholder keys)

# --- Auth ---
# REQUIRED for docker compose / production. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Bootstrap admin, created on first start when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Self-service sign-up creates read-only "viewer" users only.
ALLOW_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Local dev default is SQLite. docker compose overrides this to Postgres using the values below.
DATABASE_URL=sqlite:///./certplatform.db
POSTGRES_USER=certops
POSTGRES_PASSWORD=               # REQUIRED for docker compose
POSTGRES_DB=certops

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCAN_INTERVAL_HOURS=24

# --- AI agent (Gemini). Free key: https://aistudio.google.com/  Put it ONLY in .env, never in chat or code.
# From backend/, `python -m app.agent.llm --list-models` shows which models your key can use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AWS ACM (opt-in so ambient ~/.aws credentials are never used by accident) ---
AWS_DISCOVERY_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=                # e.g. a moto server for local demos

# --- Azure Key Vault ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=

# --- GCP Certificate Manager ---
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Kubernetes ---
KUBE_CONFIG_PATH=

# --- Renewal (ACME + Vault). Local test lab: docker compose -f docker-compose.renewal-lab.yml up -d
# Executing a renewal needs a human-approved plan AND a reachable Vault (the issued private key is stored there).
LETSENCRYPT_EMAIL=
# Default is Let's Encrypt STAGING. The production directory is blocked unless ACME_ALLOW_PRODUCTION=true.
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ALLOW_PRODUCTION=false
ACME_VERIFY_TLS=true
ACME_CHALLENGE=webroot
ACME_WEBROOT_PATH=
ACME_CHALLTESTSRV_URL=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_PATH_PREFIX=certops
RENEWAL_PLAN_TTL_MINUTES=15

# --- Notifications ---
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#cert-alerts
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CERT
